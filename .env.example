# ---------------------------------------------------------------------------
# Pocket Smart AI — environment variables
# Copy this file to ".env" and fill in real values.
# The app runs fully on local storage without any of these set,
# but adding them upgrades specific features as noted below.
# ---------------------------------------------------------------------------

# Optional. Only needed if you wire up real Supabase persistence
# (see supabase/README.md). Until then, the app stores data in the
# browser via src/services/localStore.js and everything still works.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Only needed if you want the AI Assistant / recommendations
# to be generated by a real LLM instead of the built-in local
# recommendation engine (src/services/localRecommendations.js), which
# works out of the box with zero configuration.
VITE_AI_API_KEY=
VITE_AI_API_URL=https://api.anthropic.com/v1/messages
